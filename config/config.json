{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "big-cal-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/bigCal/BigCalWebPart.js",
          "manifest": "./src/webparts/bigCal/BigCalWebPart.manifest.json"
        }
      ]
    }
  },
  "externals": {
    "react": "node_modules/react/umd/react.production.min.js",
    "react-dom": "node_modules/react-dom/umd/react-dom.production.min.js"
  },
  "localizedResources": {
    "BigCalWebPartStrings": "lib/webparts/bigCal/loc/{locale}.js"
  }
}
